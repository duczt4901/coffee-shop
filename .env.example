# Public native POST receiver, compiled into the static export. Leave blank until connected.
# Never put WordPress credentials, database secrets or email API keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Optional blog API base. Leave blank to keep the blog disabled.
# Configure only after verifying JSON access from your build environment.
# WORDPRESS_API_BASE_URL=https://lavuon.cu.ma/index.php/wp-json/
# Alternative: https://lavuon.cu.ma/?rest_route=/
WORDPRESS_API_BASE_URL=

# Product catalog, images, page fields and Yoast are downloaded only before dev/build.
# Defaults to the verified store below; independent of the optional blog setting above.
WOOCOMMERCE_API_BASE_URL=https://lavuon.cu.ma/index.php/wp-json/
